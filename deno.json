{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@opencode-ai/plugin/tui": "npm:@opencode-ai/plugin@1.18.8/tui",
    "@opencode-ai/sdk/v2": "npm:@opencode-ai/sdk@1.18.8/v2",
    "@opentui/core": "npm:@opentui/core@0.4.5",
    "@opentui/solid": "npm:@opentui/solid@0.4.5",
    "solid-js": "npm:solid-js@1.9.12"
  },
  "tasks": {
    "check": "deno check --min-dep-age 0 src/index.tsx src/predict.ts src/ui.tsx src/state.ts",
    "build": "deno run -A --node-modules-dir tools/build.ts"
  },
  "exclude": ["node_modules"]
}
