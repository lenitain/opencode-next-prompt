{
  "name": "opencode-next-prompt",
  "version": "0.1.0",
  "description": "Predicts your next message after the assistant replies in OpenCode — accept it with the right arrow",
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tui.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "bun tools/build.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run check && bun test && bun run compile"
  },
  "engines": {
    "opencode": ">=2.0.12"
  },
  "peerDependencies": {
    "@opencode/client": ">=2.0.12",
    "@opencode/plugin": ">=2.0.12",
    "@opentui/core": ">=0.5.11",
    "@opentui/solid": ">=0.5.11",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/client": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/client": "^2.1.4",
    "@opencode/plugin": "^2.1.4",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/node": "^22.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "opencode-plugin",
    "tui",
    "suggestion",
    "prediction"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenitain/opencode-next-prompt.git"
  },
  "bugs": {
    "url": "https://github.com/lenitain/opencode-next-prompt/issues"
  }
}
