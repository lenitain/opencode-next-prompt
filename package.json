{
  "name": "opencode-next-prompt",
  "version": "0.2.0",
  "description": "Predicts your next message after the assistant replies in OpenCode — accept it with a keypress",
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tui.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "bun tools/build.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun tools/smoke.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"tools/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"tools/**/*.ts\"",
    "prepublishOnly": "bun run check && bun run format:check && bun test && bun run compile && bun run smoke"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "opencode": ">=2.1.4"
  },
  "peerDependencies": {
    "@opencode/client": ">=2.1.4",
    "@opencode/plugin": ">=2.1.4",
    "@opentui/core": ">=0.6.0",
    "@opentui/solid": ">=0.6.0"
  },
  "peerDependenciesMeta": {
    "@opencode/client": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/client": "^2.1.4",
    "@opencode/plugin": "^2.1.4",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "solid-js": "1.9.12",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "opencode-plugin",
    "tui",
    "suggestion",
    "prediction"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenitain/opencode-next-prompt.git"
  },
  "bugs": {
    "url": "https://github.com/lenitain/opencode-next-prompt/issues"
  }
}
